{
  "properties": {
    "engine": {
      "type": "string",
      "const": "gpt-sovits-v5",
      "title": "Engine",
      "default": "gpt-sovits-v5"
    },
    "variant": {
      "type": "string",
      "enum": [
        "v5dev",
        "v5turbo"
      ],
      "title": "Variant",
      "default": "v5dev"
    },
    "stage": {
      "type": "string",
      "enum": [
        "both",
        "gpt",
        "sovits"
      ],
      "title": "Stage",
      "default": "both"
    },
    "python_path": {
      "type": "string",
      "title": "Python Path",
      "default": ""
    },
    "trainer_path": {
      "type": "string",
      "title": "Trainer Path",
      "default": ""
    },
    "model_path": {
      "type": "string",
      "title": "Model Path",
      "default": ""
    },
    "pretrained_gpt": {
      "type": "string",
      "title": "Pretrained Gpt",
      "default": ""
    },
    "pretrained_sovits": {
      "type": "string",
      "title": "Pretrained Sovits",
      "default": ""
    },
    "gpt": {
      "$ref": "#/$defs/GptSettings"
    },
    "sovits": {
      "$ref": "#/$defs/SovitsSettings"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "title": "GptSovitsVersionConfig",
  "$defs": {
    "GptSettings": {
      "properties": {
        "epochs": {
          "type": "integer",
          "maximum": 10000,
          "minimum": 1,
          "title": "Epochs",
          "default": 15
        },
        "batch_size": {
          "type": "integer",
          "maximum": 1024,
          "minimum": 1,
          "title": "Batch Size",
          "default": 8
        },
        "precision": {
          "type": "string",
          "enum": [
            "16-mixed",
            "32-true"
          ],
          "title": "Precision",
          "default": "16-mixed"
        },
        "seed": {
          "type": "integer",
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Seed",
          "default": 1234
        },
        "save_every_epoch": {
          "type": "integer",
          "maximum": 10000,
          "minimum": 1,
          "title": "Save Every Epoch",
          "default": 5
        },
        "save_latest": {
          "type": "boolean",
          "title": "Save Latest",
          "default": true
        },
        "learning_rate": {
          "type": "number",
          "maximum": 1,
          "exclusiveMinimum": 0,
          "title": "Learning Rate",
          "default": 0.01
        },
        "initial_learning_rate": {
          "type": "number",
          "maximum": 1,
          "exclusiveMinimum": 0,
          "title": "Initial Learning Rate",
          "default": 0.00001
        },
        "final_learning_rate": {
          "type": "number",
          "maximum": 1,
          "exclusiveMinimum": 0,
          "title": "Final Learning Rate",
          "default": 0.0001
        },
        "warmup_steps": {
          "type": "integer",
          "maximum": 10000000,
          "minimum": 1,
          "title": "Warmup Steps",
          "default": 2000
        },
        "decay_steps": {
          "type": "integer",
          "maximum": 10000000,
          "minimum": 2,
          "title": "Decay Steps",
          "default": 40000
        },
        "dpo": {
          "type": "boolean",
          "title": "Dpo",
          "default": false
        },
        "max_seconds": {
          "type": "integer",
          "maximum": 54,
          "minimum": 1,
          "title": "Max Seconds",
          "default": 54
        },
        "num_workers": {
          "type": "integer",
          "maximum": 64,
          "minimum": 1,
          "title": "Num Workers",
          "default": 4
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "GptSettings"
    },
    "SovitsSettings": {
      "properties": {
        "epochs": {
          "type": "integer",
          "maximum": 10000,
          "minimum": 1,
          "title": "Epochs",
          "default": 2
        },
        "batch_size": {
          "type": "integer",
          "maximum": 1024,
          "minimum": 1,
          "title": "Batch Size",
          "default": 1
        },
        "precision": {
          "type": "string",
          "enum": [
            "fp16",
            "fp32"
          ],
          "title": "Precision",
          "default": "fp16"
        },
        "seed": {
          "type": "integer",
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Seed",
          "default": 1234
        },
        "save_every_epoch": {
          "type": "integer",
          "maximum": 10000,
          "minimum": 1,
          "title": "Save Every Epoch",
          "default": 1
        },
        "save_latest": {
          "type": "boolean",
          "title": "Save Latest",
          "default": true
        },
        "learning_rate": {
          "type": "number",
          "maximum": 1,
          "exclusiveMinimum": 0,
          "title": "Learning Rate",
          "default": 0.0001
        },
        "adam_beta1": {
          "type": "number",
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Adam Beta1",
          "default": 0.8
        },
        "adam_beta2": {
          "type": "number",
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Adam Beta2",
          "default": 0.99
        },
        "adam_epsilon": {
          "type": "number",
          "maximum": 1,
          "exclusiveMinimum": 0,
          "title": "Adam Epsilon",
          "default": 1e-9
        },
        "lr_decay": {
          "type": "number",
          "maximum": 1,
          "exclusiveMinimum": 0,
          "title": "Lr Decay",
          "default": 0.999875
        },
        "log_interval": {
          "type": "integer",
          "maximum": 10000000,
          "minimum": 1,
          "title": "Log Interval",
          "default": 100
        },
        "lora_rank": {
          "type": "integer",
          "enum": [
            16,
            32,
            64,
            128
          ],
          "title": "Lora Rank",
          "default": 32
        },
        "gradient_checkpointing": {
          "type": "boolean",
          "title": "Gradient Checkpointing",
          "default": false
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "SovitsSettings"
    }
  }
}
